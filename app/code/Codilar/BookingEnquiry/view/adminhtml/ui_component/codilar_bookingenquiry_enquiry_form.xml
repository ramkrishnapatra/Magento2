<?xml version="1.0"?>
<form xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Ui:etc/ui_configuration.xsd">
    <argument name="data" xsi:type="array">
        <item name="js_config" xsi:type="array">
            <item name="provider" xsi:type="string">codilar_bookingenquiry_enquiry_form.codilar_bookingenquiry_enquiry_form_data_source</item>
        </item>
        <item name="template" xsi:type="string">
            templates/form/collapsible
        </item>
    </argument>
    <settings>
        <buttons>
            <button name="back" class="Codilar\BookingEnquiry\Block\Adminhtml\Enquiry\Edit\BackButton"/>
            <button name="save" class="Codilar\BookingEnquiry\Block\Adminhtml\Enquiry\Edit\SaveButton"/>
        </buttons>
        <namespace>codilar_bookingenquiry_enquiry_form</namespace>
        <dataScope>data</dataScope>
        <deps>
            <dep>codilar_bookingenquiry_enquiry_form.codilar_bookingenquiry_enquiry_form_data_source</dep>
        </deps>
    </settings>

    <dataSource name="codilar_bookingenquiry_enquiry_form_data_source">
        <argument name="data" xsi:type="array">
            <item name="js_config" xsi:type="array">
                <item name="component" xsi:type="string">Magento_Ui/js/form/provider</item>
            </item>
        </argument>
        <settings>
            <submitUrl path="codilar_bookingenquiry/enquiry/save"/>
        </settings>
        <dataProvider name="codilar_bookingenquiry_enquiry_form_data_source"
                      class="Codilar\BookingEnquiry\Model\Enquiry\DataProvider">
            <settings>
                <requestFieldName>entity_id</requestFieldName>
                <primaryFieldName>entity_id</primaryFieldName>
            </settings>
        </dataProvider>
    </dataSource>

    <fieldset name="general">
        <settings>
            <label translate="true">Enquiry Details</label>
        </settings>

        <field name="entity_id" formElement="input">
            <settings>
                <dataType>text</dataType>
                <visible>false</visible>
            </settings>
        </field>

        <field name="phone_number" formElement="input" sortOrder="10">
            <settings>
                <dataType>text</dataType>
                <label translate="true">Customer Phone</label>
                <validation>
                    <rule name="required-entry" xsi:type="boolean">true</rule>
                </validation>
            </settings>
        </field>

        <field name="preferred_slot" formElement="input" sortOrder="20">
            <settings>
                <dataType>text</dataType>
                <label translate="true">Time Slot</label>
                <validation>
                    <rule name="required-entry" xsi:type="boolean">true</rule>
                </validation>
            </settings>
        </field>

        <field name="status" formElement="select" sortOrder="30">
            <argument name="data" xsi:type="array">
                <item name="options" xsi:type="object">Codilar\BookingEnquiry\Model\Enquiry\Source\Status</item>
            </argument>
            <settings>
                <dataType>text</dataType>
                <label translate="true">Status</label>
                <validation>
                    <rule name="required-entry" xsi:type="boolean">true</rule>
                </validation>
            </settings>
        </field>
    </fieldset>
</form>
