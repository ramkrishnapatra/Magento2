<?xml version="1.0" encoding="UTF-8"?>
<widgets xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Widget:etc/widget.xsd">
    <widget id="codilar_same_category_cms_widget" class="Codilar\SameCategory\Block\Widget\CmsBlockRenderer">
        <label translate="true">Codilar Same Category CMS Block Widget</label>
        <description translate="true">Renders the selected CMS block containing Category Slider.</description>
        <parameters>
            <parameter name="block_id" xsi:type="block" visible="true" required="true" sort_order="10">
                <label translate="true">Select CMS Block</label>
                <block class="Magento\Cms\Block\Adminhtml\Block\Widget\Chooser">
                    <data>
                        <item name="button" xsi:type="array">
                            <item name="open" xsi:type="string" translate="true">Select Block...</item>
                        </item>
                    </data>
                </block>
            </parameter>
        </parameters>
    </widget>
</widgets>
