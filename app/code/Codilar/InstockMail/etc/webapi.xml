<?xml version="1.0"?>
<routes xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Webapi:etc/webapi.xsd">

    <!-- Guest / Public Stock Alert Subscription API -->
    <route url="/V1/stock-alert/subscribe" method="POST">
        <service class="Codilar\InstockMail\Api\StockAlertRepositoryInterface" method="subscribe"/>
        <resources>
            <resource ref="anonymous"/>
        </resources>
    </route>
</routes>
