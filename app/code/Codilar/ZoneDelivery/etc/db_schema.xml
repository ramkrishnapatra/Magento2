<?xml version="1.0"?>
<schema xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:framework:Setup/Declaration/Schema/etc/schema.xsd">

    <!-- 1. Delivery Zones Master Table -->
    <table name="magecafe_delivery_zone" resource="default" engine="innodb" comment="Delivery Zones Master Table">
        <column xsi:type="int" name="entity_id" unsigned="true" nullable="false" identity="true" comment="Entity ID"/>
        <column xsi:type="varchar" name="zone_reference" nullable="false" length="64" comment="Zone Code Reference"/>
        <column xsi:type="varchar" name="description" nullable="true" length="255" comment="Zone Description"/>
        <column xsi:type="boolean" name="is_remote" nullable="false" default="false" comment="Is Remote Area Flag"/>
        <constraint xsi:type="primary" referenceId="PRIMARY">
            <column name="entity_id"/>
        </constraint>
        <constraint xsi:type="unique" referenceId="MAGECAFE_DELIVERY_ZONE_REFERENCE_UNIQUE">
            <column name="zone_reference"/>
        </constraint>
    </table>

    <!-- 2. Pincode to Zone Mapping Table -->
    <table name="magecafe_delivery_pincode" resource="default" engine="innodb" comment="Pincode to Zone Mapping">
        <column xsi:type="int" name="entity_id" unsigned="true" nullable="false" identity="true" comment="Entity ID"/>
        <column xsi:type="varchar" name="pincode" nullable="false" length="16" comment="Postal Code"/>
        <column xsi:type="int" name="zone_id" unsigned="true" nullable="false" comment="Zone Reference ID"/>
        <constraint xsi:type="primary" referenceId="PRIMARY">
            <column name="entity_id"/>
        </constraint>
        <constraint xsi:type="unique" referenceId="MAGECAFE_DELIVERY_PINCODE_UNIQUE">
            <column name="pincode"/>
        </constraint>
        <constraint xsi:type="foreign" referenceId="FK_MAGECAFE_PINCODE_ZONE_ID"
                    table="magecafe_delivery_pincode" column="zone_id"
                    referenceTable="magecafe_delivery_zone" referenceColumn="entity_id"
                    onDelete="CASCADE"/>
        <index referenceId="IDX_MAGECAFE_PINCODE_ZONE_ID" indexType="btree">
            <column name="zone_id"/>
        </index>
    </table>

    <!-- 3. Delivery Rates Tier Table -->
    <table name="magecafe_delivery_rate" resource="default" engine="innodb" comment="Zone Shipping Rates Tier">
        <column xsi:type="int" name="rate_id" unsigned="true" nullable="false" identity="true" comment="Rate ID"/>
        <column xsi:type="int" name="zone_id" unsigned="true" nullable="false" comment="Zone Reference ID"/>
        <column xsi:type="smallint" name="website_id" unsigned="true" nullable="false" default="0" comment="Website ID"/>
        <column xsi:type="decimal" name="weight_from" scale="4" precision="12" nullable="false" default="0.0000" comment="Weight Lower Bound"/>
        <column xsi:type="decimal" name="weight_to" scale="4" precision="12" nullable="false" default="999999.0000" comment="Weight Upper Bound"/>
        <column xsi:type="decimal" name="order_value_from" scale="4" precision="12" nullable="false" default="0.0000" comment="Order Value Lower Bound"/>
        <column xsi:type="decimal" name="order_value_to" scale="4" precision="12" nullable="false" default="999999.0000" comment="Order Value Upper Bound"/>
        <column xsi:type="decimal" name="charge" scale="4" precision="12" nullable="false" default="0.0000" comment="Base Delivery Charge"/>
        <column xsi:type="decimal" name="oversized_surcharge" scale="4" precision="12" nullable="false" default="0.0000" comment="Oversized Item Additional Surcharge"/>
        <constraint xsi:type="primary" referenceId="PRIMARY">
            <column name="rate_id"/>
        </constraint>
        <constraint xsi:type="foreign" referenceId="FK_MAGECAFE_RATE_ZONE_ID"
                    table="magecafe_delivery_rate" column="zone_id"
                    referenceTable="magecafe_delivery_zone" referenceColumn="entity_id"
                    onDelete="CASCADE"/>
        <index referenceId="IDX_MAGECAFE_RATE_LOOKUP" indexType="btree">
            <column name="zone_id"/>
            <column name="weight_from"/>
            <column name="weight_to"/>
            <column name="order_value_from"/>
            <column name="order_value_to"/>
        </index>
    </table>

    <!-- 4. Delivery Slots Master Table -->
    <table name="magecafe_delivery_slot" resource="default" engine="innodb" comment="Delivery Slots Master">
        <column xsi:type="int" name="slot_id" unsigned="true" nullable="false" identity="true" comment="Slot ID"/>
        <column xsi:type="varchar" name="slot_reference" nullable="false" length="64" comment="Slot Reference Name"/>
        <column xsi:type="varchar" name="start_time" nullable="false" length="16" comment="Slot Window Start (HH:MM:SS)"/>
        <column xsi:type="varchar" name="end_time" nullable="false" length="16" comment="Slot Window End (HH:MM:SS)"/>
        <column xsi:type="int" name="capacity_per_day" unsigned="true" nullable="false" default="10" comment="Maximum Orders Capacity"/>
        <column xsi:type="varchar" name="applicable_zones" nullable="true" length="255" comment="CSV Allowed Zones"/>
        <column xsi:type="boolean" name="is_active" nullable="false" default="true" comment="Active Flag"/>
        <constraint xsi:type="primary" referenceId="PRIMARY">
            <column name="slot_id"/>
        </constraint>
    </table>

    <!-- 5. Concurrency Booking Ledger Table -->
    <table name="magecafe_delivery_slot_booking" resource="default" engine="innodb" comment="Slot Reservation Ledger">
        <column xsi:type="int" name="booking_id" unsigned="true" nullable="false" identity="true" comment="Booking ID"/>
        <column xsi:type="int" name="slot_id" unsigned="true" nullable="false" comment="Slot Reference ID"/>
        <column xsi:type="date" name="delivery_date" nullable="false" comment="Booked Delivery Date"/>
        <column xsi:type="int" name="quote_id" unsigned="true" nullable="true" comment="Associated Quote ID"/>
        <column xsi:type="int" name="order_id" unsigned="true" nullable="true" comment="Associated Sales Order ID"/>
        <column xsi:type="varchar" name="status" nullable="false" length="32" default="reserved" comment="Status: reserved/confirmed/cancelled"/>
        <column xsi:type="timestamp" name="reserved_at" on_update="false" default="CURRENT_TIMESTAMP" comment="Reservation Timestamp"/>
        <column xsi:type="timestamp" name="confirmed_at" nullable="true" comment="Confirmation Timestamp"/>
        <constraint xsi:type="primary" referenceId="PRIMARY">
            <column name="booking_id"/>
        </constraint>
        <constraint xsi:type="foreign" referenceId="FK_MAGECAFE_BOOKING_SLOT_ID"
                    table="magecafe_delivery_slot_booking" column="slot_id"
                    referenceTable="magecafe_delivery_slot" referenceColumn="slot_id"
                    onDelete="CASCADE"/>
        <index referenceId="IDX_MAGECAFE_SLOT_DATE_STATUS" indexType="btree">
            <column name="slot_id"/>
            <column name="delivery_date"/>
            <column name="status"/>
        </index>
    </table>

    <!-- 6. Extend Core Quote Table -->
    <table name="quote">
        <column xsi:type="int" name="delivery_slot_id" unsigned="true" nullable="true" comment="Delivery Slot ID"/>
        <column xsi:type="date" name="delivery_date" nullable="true" comment="Delivery Date"/>
    </table>

    <!-- 7. Extend Core Sales Order Table -->
    <table name="sales_order">
        <column xsi:type="int" name="delivery_slot_id" unsigned="true" nullable="true" comment="Delivery Slot ID"/>
        <column xsi:type="date" name="delivery_date" nullable="true" comment="Delivery Date"/>
    </table>
</schema>
